# Copier en .env et remplir. Ne jamais committer .env (voir .gitignore).

# --- LLM Provider ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-large

# --- Vector store ---
VECTOR_STORE_BACKEND=pgvector   # pgvector | faiss | chroma
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=changeme

# --- Graph store (optionnel, si architecture Graph RAG) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Ingestion / Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Retrieval ---
TOP_K=5

# --- Evaluation ---
RAGAS_LLM_MODEL=claude-sonnet-5

# --- App ---
LOG_LEVEL=INFO
ENVIRONMENT=dev   # dev | staging | prod
